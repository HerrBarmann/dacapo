#!/bin/bash
# firstrun.sh — kiosk on the Raspberry Pi, profile "@@PROFILE@@"
# GENERATED by raspberry/make-firstrun.sh from firstrun.sh.in — do not edit by
# hand, regenerate instead.
#
# For: Raspberry Pi OS LITE (64-bit), Debian 13 "Trixie", Raspberry Pi 4/5
# ──────────────────────────────────────────────────────────────────────────
# Stage 1 (this script): runs ONCE at the first boot via
#   systemd.run=/boot/firmware/firstrun.sh in cmdline.txt, WITHOUT network.
#   It only writes files: profile marker, optional CA, the bootstrap service
#   for stage 2 — and removes itself from cmdline.txt.
# Stage 2 (kiosk-bootstrap.service, at the next boot WITH network):
#   installs git + ansible, pulls the site repository (ansible-pull) and boots
#   into the finished kiosk on success. If it fails (no network, wrong token)
#   the reason is in /boot/firmware/kiosk-bootstrap.log and the next boot
#   tries again.
# Afterwards the Pi maintains itself like every other kiosk (ansible-pull timer).
#
# Idempotent: can be run again on the running system (sudo bash firstrun.sh)
# — resets the bootstrap then.
exec > /boot/firmware/firstrun.log 2>&1
set -u
echo "=== firstrun.sh (profile @@PROFILE@@) started: $(date) ==="

mkdir -p @@STATE_DIR@@
echo "@@PROFILE@@" > @@PROFILE_FILE@@

# Pull URL (incl. deploy token, root only) for stage 2
cat > @@STATE_DIR@@/bootstrap.conf <<'CONF'
PULL_URL="@@PULL_URL@@"
BRANCH="@@BRANCH@@"
PLAYBOOK="@@PLAYBOOK@@"
PROFILE="@@PROFILE@@"
CONF
chmod 0600 @@STATE_DIR@@/bootstrap.conf
rm -f @@STATE_DIR@@/bootstrapped

@@CA_BLOCK@@

# ── Stage 2: bootstrap script ─────────────────────────────────────────────
cat > /usr/local/sbin/kiosk-bootstrap.sh <<'BOOTSTRAP'
#!/bin/bash
# kiosk-bootstrap.sh — stage 2 of the Pi setup (see firstrun.sh).
set -u
LOG=/boot/firmware/kiosk-bootstrap.log
exec >> "$LOG" 2>&1
echo "=== kiosk-bootstrap started: $(date) ==="
. @@STATE_DIR@@/bootstrap.conf
GIT_HOST=$(printf '%s' "$PULL_URL" | sed -E 's#^https?://([^@/]*@)?([^/:]+).*#\2#')

echo ">>> Waiting for network/DNS (deb.debian.org, $GIT_HOST) ..."
for _ in $(seq 1 60); do
    getent hosts deb.debian.org >/dev/null 2>&1 && getent hosts "$GIT_HOST" >/dev/null 2>&1 && break
    sleep 5
done
if ! getent hosts "$GIT_HOST" >/dev/null 2>&1; then
    echo "ERROR: no DNS for $GIT_HOST — check LAN cable/Wi-Fi. The next boot tries again."
    exit 1
fi

echo ">>> Waiting for time synchronisation (TLS/signatures need the right clock) ..."
for _ in $(seq 1 30); do
    [ "$(timedatectl show -p NTPSynchronized --value 2>/dev/null)" = "yes" ] && break
    sleep 2
done

echo ">>> Checking dpkg state (in case an earlier run was interrupted) ..."
dpkg --configure -a || true
apt-get -f install -y || true

echo ">>> Installing git + ansible ..."
export DEBIAN_FRONTEND=noninteractive
apt-get update -y
apt-get install -y git ansible ca-certificates
update-ca-certificates

echo ">>> ansible-pull ($PROFILE, branch $BRANCH) ..."
export PYTHONUNBUFFERED=1
if ansible-pull -v -U "$PULL_URL" -i localhost, --checkout "$BRANCH" -e "profile=$PROFILE" "$PLAYBOOK"; then
    touch @@STATE_DIR@@/bootstrapped
    systemctl disable kiosk-bootstrap.service 2>/dev/null || true
    echo "=== Bootstrap successful: $(date) — rebooting into the kiosk ==="
    systemctl reboot
else
    echo "ERROR: ansible-pull failed ($(date)). Usually: deploy token/URL, CA or network."
    echo "       The next boot tries again; right now: sudo systemctl start kiosk-bootstrap"
    exit 1
fi
BOOTSTRAP
chmod 0755 /usr/local/sbin/kiosk-bootstrap.sh

cat > /etc/systemd/system/kiosk-bootstrap.service <<'UNIT'
[Unit]
Description=Kiosk bootstrap (once: install ansible and pull the site repository)
ConditionPathExists=!@@STATE_DIR@@/bootstrapped
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
TimeoutStartSec=0
ExecStart=/usr/local/sbin/kiosk-bootstrap.sh

[Install]
WantedBy=multi-user.target
UNIT
mkdir -p /etc/systemd/system/multi-user.target.wants
ln -sf /etc/systemd/system/kiosk-bootstrap.service \
       /etc/systemd/system/multi-user.target.wants/kiosk-bootstrap.service
# network-online.target should really wait for a connection (NetworkManager)
mkdir -p /etc/systemd/system/network-online.target.wants
[ -f /lib/systemd/system/NetworkManager-wait-online.service ] && \
    ln -sf /lib/systemd/system/NetworkManager-wait-online.service \
           /etc/systemd/system/network-online.target.wants/NetworkManager-wait-online.service

# ── Plausibility: right image? ────────────────────────────────────────────
if [ -f /lib/systemd/system/lightdm.service ]; then
    echo "WARNING: lightdm found — was 'Raspberry Pi OS with desktop' flashed? LITE is intended."
fi

# ── Clean-up: remove firstrun from cmdline.txt ────────────────────────────
CMDLINE=/boot/firmware/cmdline.txt
sed -i 's| systemd\.run=/boot/firmware/firstrun\.sh||g' "$CMDLINE"
sed -i 's| systemd\.run_success_action=reboot||g'       "$CMDLINE"
sed -i 's| systemd\.run_failure_action=reboot||g'       "$CMDLINE"

echo "=== firstrun.sh finished: $(date) — stage 2 follows at the next boot ==="
exit 0
