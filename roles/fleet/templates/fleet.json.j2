{{ {
  "url": fleet_url,
  "repo_user": fleet_repo_user,
  "repo_password": fleet_repo_password,
  "enroll_key": fleet_enroll_key,
  "profile_file": kiosk_profile_file,
  "state_dir": fleet_state_dir,
  "nightly_reboot": nightly_reboot_time | string,
  "monitor_port": (monitor_port | default(8081) | int) if (monitor_enabled | default(false) | bool) else 0,
  "monitor_url": (monitor_url | default('')) if (monitor_enabled | default(false) | bool) else '',
  "core_version": dacapo_version | default(''),
  "settable": fleet_settable_vars | default([]),
  "vars_file": fleet_vars_file,
  "host_vars_files": kiosk_host_vars_files | default([]),
  "preview": {
    "files": {
      "waybar_config": "/etc/xdg/waybar/config",
      "waybar_style": "/etc/xdg/waybar/style.css",
      "homepage": "/opt/kiosk/homepage/index.html",
      "policies": "/etc/firefox-esr/policies/policies.json"
    },
    "assets_dir": "/opt/kiosk/homepage/assets",
    "meta": {"firefox_mode": firefox_mode | default("browser"), "waybar_enabled": waybar_enabled | default(true) | bool}
  }
} | to_nice_json(indent=2) }}
