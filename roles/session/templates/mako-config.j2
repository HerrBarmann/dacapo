# /etc/xdg/mako/config — idle warning of the kiosk session as a popup
# (Jinja2 template roles/session/templates/mako-config.j2, deployed by ansible-pull)
# Styled like the bar: dark, accent border, site font, flat. Centred on the
# overlay layer — the screen content is not moved. kiosk-idle-warn.sh
# refreshes the content every second (notify-send --replace-id); only one
# notification is visible. Web pages cannot use this daemon (Firefox policy
# Permissions.Notifications.BlockNewRequests).
layer=overlay
anchor=center
output=
max-visible=1
sort=-time
width={{ popup_width }}
height={{ popup_height }}
margin=0
padding=30,40
border-size=4
border-color={{ color_accent }}
border-radius=0
background-color={{ color_popup_bg }}
text-color={{ color_popup_fg | lower }}
font={{ kiosk_font_family }} {{ popup_font_size }}
markup=1
format=<b>%s</b>\n%b
icons=1
max-icon-size=110
icon-location=left
text-alignment=left
# Stays as long as the script refreshes it; when the script dies (reset,
# input) the popup disappears on its own after 3 s at the latest.
default-timeout=3000
ignore-timeout=0
on-button-left=dismiss-all
on-button-right=dismiss-all
on-touch=dismiss-all

# Last {{ [idle_warn_seconds | int, 10] | min }} seconds: danger-coloured border
[urgency=critical]
border-color={{ color_danger }}
