# /etc/NetworkManager/system-connections/kiosk-wlan.nmconnection
# Kiosk Wi-Fi fallback (deployed by ansible-pull; values derived from
# <site>/files/wpa-kiosk-wlan.conf). Ethernet wins where a cable is connected
# (NetworkManager prefers wired connections).
[connection]
id=kiosk-wlan
type=wifi
interface-name=wlan0
autoconnect=true
autoconnect-priority=-10

[wifi]
ssid={{ wlan_ssid }}
mode=infrastructure

{% if wlan_psk %}
[wifi-security]
key-mgmt=wpa-psk
psk={{ wlan_psk }}
{% else %}
[wifi-security]
key-mgmt=wpa-eap

[802-1x]
eap=ttls;
phase2-auth=pap
identity={{ wlan_identity }}
password={{ wlan_password }}
{% endif %}

[ipv4]
method=auto

[ipv6]
method=auto
